        </div>
        <!-- Avito Logo -->
        <div class="absolute left-[76.99px] top-[0.01px] w-[130.79px] h-[130.79px]">
          <img 
            src="/assets/about/avito.svg" 
            alt="Avito" 
            class="w-full h-full object-contain"
          />
        </div>
        <!-- Ellipses behind Raif -->
        <div class="absolute left-[97.83px] top-0 w-[130.818px] h-[130.818px]" style="transform: scale(1.2806); transform-origin: center;">
