            </svg>
            Написать мне
          </a>
        </div>
      </div>
      <!-- Image and logos -->
      <div class="relative h-[140px] w-[335px] shrink-0 overflow-hidden">
        <!-- Profile Photo (leftmost) -->
        <div class="absolute left-0 top-0 w-[130.818px] h-[130.818px] overflow-hidden rounded-[10.765px]">
