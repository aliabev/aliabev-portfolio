          <img 
            src="/assets/about/ellipse-2.svg" 
            alt="" 
            class="w-full h-full object-contain"
          />
        </div>
        <!-- QIWI Logo -->
        <div class="absolute left-[423.94px] top-[0.03px] w-[240.107px] h-[240.107px]">
          <img 
            src="/assets/about/qiwi.svg" 
            alt="QIWI" 
            class="w-full h-full object-contain"
          />
        </div>
      </div>
    </div>

    <!-- Mobile version (375px) -->
    <div class="flex lg:hidden flex-col gap-[47px] items-start px-[40px] py-[48px]">
      <!-- Text content -->
      <div class="flex flex-col gap-[28px] py-[7px] w-full">
        <div class="flex flex-col gap-[10px] text-[#f8f6f2] w-full">
          <!-- Title -->
          <h1 class="font-['Aeroport'] font-normal text-[28px] leading-normal opacity-90">
