---
const {
  title = "Дмитрий Алябьев",
  lead = "Team Lead Product Designer. Более 15 лет улучшаю дизайн в продуктовых командах финтеха и классифайда в роли product designer, art director, team lead, product manager.",
  description = "С накопленным T-shaped опытом выстраиваю кросс-функциональные процессы, интегрирую дизайн в продуктовую стратегию с фокусом на рост целевых метрик. Развиваю дизайн-команды, но и не боюсь работы руками.",
  cvHref = "/cv.pdf",
  tgHref = "https://t.me/alyabev",
} = Astro.props;
---

<section class="mt-8 md:mt-10">
  <div class="rounded-[22px] bg-[#0b0219] text-[#f8f6f2] overflow-hidden">
    <!-- Desktop version (1368px) -->
    <div class="hidden lg:flex items-start justify-between pl-[82px] pr-0 py-[82px]">
      <!-- Text content left -->
      <div class="flex flex-col gap-[28px] py-[7px] w-[576px]">
        <div class="flex flex-col gap-[10px] text-[#f8f6f2] w-full">
          <!-- Title -->
          <h1 class="font-['Aeroport'] font-normal text-[28px] leading-normal opacity-90">
            {title}
          </h1>
          <!-- Description -->
          <div class="font-['Aeroport'] font-light text-[18px] leading-[1.3]">
            <p class="mb-0">{lead}</p>
            <p class="mb-0">&nbsp;</p>
            <p>{description}</p>
          </div>
        </div>
        <!-- Links -->
        <div class="flex gap-[31px] items-center">
          <a 
            href={cvHref} 
            class="font-['Aeroport'] font-normal text-[19px] text-[#f8f6f2] tracking-[-0.19px] underline underline-offset-[25%] decoration-solid"
          >
            CV
          </a>
          <a 
            href={tgHref} 
            class="flex gap-[10px] items-center font-['Aeroport'] font-normal text-[19px] text-[#f8f6f2] opacity-90 underline underline-offset-[25%] decoration-solid"
          >
            <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M9.18 14.56L8.99 18C9.38 18 9.55 17.83 9.75 17.63L12.57 14.89L16.34 17.65C16.85 17.98 17.34 17.78 17.51 17.14L20.98 5.52C21.23 4.36 20.56 3.89 19.83 4.17L3.92 9.53C2.81 9.96 2.81 10.58 3.73 10.88L8.12 12.23L15.93 6.26C16.39 5.98 16.81 6.13 16.46 6.42L10.32 12.07L9.18 14.56Z" fill="currentColor"/>
            </svg>
            Написать мне
          </a>
        </div>
      </div>
      <!-- Image and logos right -->
      <div class="relative h-[267px] w-[615px] shrink-0 overflow-hidden">
        <!-- Profile Photo (leftmost) -->
        <div class="absolute left-0 top-0 w-[240.158px] h-[240.158px] overflow-hidden rounded-[19.762px]">
          <div class="absolute inset-0 bg-black rounded-[19.762px]"></div>
          <img 
            src="/assets/about/profile-photo.png" 
            alt="Дмитрий Алябьев" 
            class="absolute inset-0 w-full h-full object-cover object-[50%_50%] opacity-70 rounded-[19.762px]"
          />
        </div>
        <!-- Ellipses behind Avito -->
        <div class="absolute left-[27.71px] top-0 w-[240.158px] h-[240.158px]" style="transform: scale(1.2806); transform-origin: center;">
          <img 
            src="/assets/about/ellipse-1.svg" 
            alt="" 
            class="w-full h-full object-contain"
          />
        </div>
        <div class="absolute left-[72.64px] top-0 w-[240.158px] h-[240.158px]" style="transform: scale(1.2806); transform-origin: center;">
          <img 
            src="/assets/about/ellipse-4.svg" 
            alt="" 
            class="w-full h-full object-contain"
          />
        </div>
        <!-- Avito Logo -->
        <div class="absolute left-[141.35px] top-[0.03px] w-[240.107px] h-[240.107px]">
          <img 
            src="/assets/about/avito.svg" 
            alt="Avito" 
            class="w-full h-full object-contain"
          />
        </div>
        <!-- Ellipses behind Raif -->
        <div class="absolute left-[179.59px] top-0 w-[240.158px] h-[240.158px]" style="transform: scale(1.2806); transform-origin: center;">
          <img 
            src="/assets/about/ellipse-1.svg" 
            alt="" 
            class="w-full h-full object-contain"
          />
        </div>
        <div class="absolute left-[207.05px] top-0 w-[240.158px] h-[240.158px]" style="transform: scale(1.2806); transform-origin: center;">
          <img 
            src="/assets/about/ellipse-3.svg" 
            alt="" 
            class="w-full h-full object-contain"
          />
        </div>
        <!-- Raif Logo -->
        <div class="absolute left-[282.64px] top-[0.03px] w-[240.107px] h-[240.107px]">
          <img 
            src="/assets/about/raif.svg" 
